# Stripe secret or restricted key. Use a READ-ONLY restricted key for the live dashboard.
# In the Claude cloud environment the proxy injects the real key; set this to "proxy-injected".
STRIPE_SECRET_KEY=
BUSINESS_TZ=America/New_York
DATABASE_URL=postgresql://postgres@localhost:5432/portal_dev
# Direct (non-pooled) connection for migrations; same as DATABASE_URL locally
DATABASE_URL_UNPOOLED=postgresql://postgres@localhost:5432/portal_dev
STRIPE_WEBHOOK_SECRET=
# 32+ random characters; signs login sessions
AUTH_SECRET=
# Only needed once, to create the first Super Admin at /setup. Remove after setup.
SETUP_TOKEN=
