generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Neon on Vercel provides a pooled DATABASE_URL and a direct DATABASE_URL_UNPOOLED (used for migrations).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
}

enum ClientType {
  DIRECT
  ACE
}

enum ClientStatus {
  ONBOARDING
  PREPAID_ACE
  CURRENT
  UNPAID
  PAST_DUE
  AT_RISK
  PAUSED
  SUSPENDED
  CONTINUING_AWAITING_PM
  ENDED
}

enum InvoiceKind {
  SUBSCRIPTION
  ONBOARDING
  ACE_BATCH
  OTHER
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String?
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  totpLastStep Int?
  createdAt    DateTime @default(now())
}

model Package {
  id                 String   @id @default(cuid())
  name               String
  stripePriceId      String?  @unique
  monthlyPriceCents  Int
  onboardingFeeCents Int
  isCustom           Boolean  @default(false)
  active             Boolean  @default(true)
  contractTemplate   String?
  contractVersion    String?
  clients            Client[]
}

model Client {
  id                    String       @id @default(cuid())
  name                  String
  email                 String?
  phone                 String?
  billingState          String?
  type                  ClientType   @default(DIRECT)
  status                ClientStatus @default(ONBOARDING)
  packageId             String?
  package               Package?     @relation(fields: [packageId], references: [id])
  stripeCustomerId      String?      @unique
  stripeSubscriptionId  String?      @unique
  ghlContactId          String?
  defaultPaymentFunding String?
  subscriptionStatus    String?
  commissionMonthsBeforePortal Int @default(0)
  acePrepaidUntil       DateTime?
  aceSlotId             String?
  continuationDecision  String?
  clientAnswer          String?
  continuationBy        String?
  clientAnsweredAt      DateTime?
  aceSetupSessionId     String?
  suspendedAt           DateTime?
  suspensionWaivedAt    DateTime?
  onboarding            Onboarding?
  createdAt             DateTime     @default(now())
  endedAt               DateTime?
  invoices              Invoice[]
  discounts             Discount[]
}

model Invoice {
  id                String      @id @default(cuid())
  stripeInvoiceId   String      @unique
  clientId          String?
  client            Client?     @relation(fields: [clientId], references: [id])
  status            String
  subtotalCents     Int
  discountCents     Int         @default(0)
  cardFeeCents      Int         @default(0)
  onboardingCents   Int         @default(0)
  refundedCents     Int         @default(0)
  refundedPackageCents Int      @default(0)
  processingSince   DateTime?
  taxCents          Int         @default(0)
  seenRefundIds     String[]    @default([])
  totalCents        Int
  amountPaidCents   Int         @default(0)
  paidAt            DateTime?
  paymentMethodType String?
  cardFunding       String?
  firstFailedAt     DateTime?
  periodStart       DateTime
  periodEnd         DateTime
  kind              InvoiceKind
}

model Discount {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  kind           DiscountKind
  percentOff     Int?
  amountOffCents Int?
  months         Int
  reason         String
  stripeCouponId String
  createdById    String
  createdAt      DateTime     @default(now())
  replacedAt     DateTime?
}

model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

model Executive {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Rows sharing (clientId, effectiveFrom) form one split version. Versions are never edited, only added.
model CommissionShare {
  id            String   @id @default(cuid())
  clientId      String
  executiveId   String
  rateBp        Int
  effectiveFrom DateTime
  createdById   String
  createdAt     DateTime @default(now())

  @@index([clientId, effectiveFrom])
}

enum CommissionKind {
  EARNED
  CLAWBACK
  ACE_PREPAID
}

/// Append-only commission ledger. The unique key makes every write idempotent.
model CommissionEntry {
  id          String         @id @default(cuid())
  executiveId String
  clientId    String
  invoiceId   String
  kind        CommissionKind
  refundKey   String         @default("")
  windowIndex Int?
  baseCents   Int
  rateBp      Int
  amountCents Int
  occurredAt  DateTime
  month       String
  createdAt   DateTime       @default(now())

  @@unique([executiveId, invoiceId, kind, refundKey])
  @@index([executiveId, month])
  @@index([clientId])
}

enum StatementStatus {
  OPEN
  PAID
}

model CommissionStatement {
  id          String          @id @default(cuid())
  executiveId String
  month       String
  status      StatementStatus @default(OPEN)
  paidAt      DateTime?
  paidById    String?
  totalCents  Int?

  @@unique([executiveId, month])
}

enum AcePayment {
  STRIPE
  OUT_OF_BAND
}

/// One bulk purchase by ACE: slots of 6 months of service + onboarding per package.
model AceBatch {
  id               String      @id @default(cuid())
  purchasedAt      DateTime
  note             String?
  totalCents       Int
  stripeInvoiceId  String?     @unique
  invoiceSentAt    DateTime?
  invoiceVersion   Int         @default(0)
  paidAt           DateTime?
  paidVia          AcePayment?
  paymentMethod    String?
  paymentReference String?
  createdById      String
  createdAt        DateTime    @default(now())
}

model AceBatchLine {
  id             String @id @default(cuid())
  batchId        String
  packageId      String
  quantity       Int
  unitPriceCents Int

  @@index([batchId])
}

model AceSlot {
  id                 String    @id @default(cuid())
  batchId            String
  packageId          String
  clientId           String?   @unique
  startDate          DateTime?
  prepaidUntil       DateTime?
  customMonthlyCents Int?

  @@index([batchId, packageId])
}

/// One row per notice key: sends each notice at most once (retrying a failure once).
model Notification {
  id        String    @id @default(cuid())
  key       String    @unique
  kind      String
  clientId  String?
  to        String?
  channels  String    @default("")
  status    String
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([clientId])
}

/** A client's self-serve onboarding progress (Plan 4B). */
model Onboarding {
  id                 String    @id @default(cuid())
  clientId           String    @unique
  client             Client    @relation(fields: [clientId], references: [id])
  packageId          String?
  monthlyCents       Int?
  onboardingFeeCents Int?
  details            Json?
  signedAt           DateTime?
  signerName         String?
  signerIp           String?
  signedText         String?
  signedHash         String?
  contractVersion    String?
  quickbooks         String?
  countersignedAt    DateTime?
  countersignedById  String?
  feeInvoiceId       String?
  feeSetupSessionId  String?
  feePaidAt          DateTime?
  feeSubmittedAt     DateTime?
  feePaymentMethodId String?
  stripeSubscriptionId String?
  intake             Json?
  intakeAt           DateTime?
  callBookedAt       DateTime?
  completedAt        DateTime?
  lastProgressAt     DateTime  @default(now())
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
