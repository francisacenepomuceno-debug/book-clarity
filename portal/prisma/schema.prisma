generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon on Vercel provides a pooled DATABASE_URL and a direct DATABASE_URL_UNPOOLED (used for migrations).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
}

enum ClientType {
  DIRECT
  ACE
}

enum ClientStatus {
  ONBOARDING
  PREPAID_ACE
  CURRENT
  UNPAID
  PAST_DUE
  AT_RISK
  PAUSED
  SUSPENDED
  CONTINUING_AWAITING_PM
  ACE_AWAITING_DECISION
  ENDED
}

enum InvoiceKind {
  SUBSCRIPTION
  ONBOARDING
  ACE_BATCH
  OTHER
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String?
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  totpLastStep Int?
  createdAt    DateTime @default(now())
}

model Package {
  id                 String               @id @default(cuid())
  name               String
  stripePriceId      String?              @unique
  monthlyPriceCents  Int
  onboardingFeeCents Int
  isCustom           Boolean              @default(false)
  active             Boolean              @default(true)
  contractTemplate   String?
  contractVersion    String?
  clients            Client[]
  priceChanges       PriceChange[]
  subscriptions      ClientSubscription[]
}

/// A scheduled package price increase (Owners / Super Admin). New clients pay the new price from the start date;
/// current clients on the full list price move at their first bill on or after it, after a 30-day notice.
model PriceChange {
  id                String            @id @default(cuid())
  packageId         String
  package           Package           @relation(fields: [packageId], references: [id])
  oldMonthlyCents   Int
  newMonthlyCents   Int
  oldStripePriceId  String
  newStripePriceId  String
  /// First day of the new price, at 00:00 in the business timezone.
  effectiveAt       DateTime
  createdById       String
  createdAt         DateTime          @default(now())
  /// When the package itself switched to the new price (new clients from then on).
  packageSwitchedAt DateTime?
  cancelledAt       DateTime?
  cancelledById     String?
  moves             PriceChangeMove[]
}

/// One current client moved to the new price (their subscription updated in Stripe).
model PriceChangeMove {
  id             String      @id @default(cuid())
  priceChangeId  String
  priceChange    PriceChange @relation(fields: [priceChangeId], references: [id])
  clientId       String
  subscriptionId String
  fromPriceId    String
  fromCents      Int
  /// The client's first bill at the new price.
  startsOn       DateTime
  appliedAt      DateTime    @default(now())

  @@unique([priceChangeId, subscriptionId])
}

/// One Stripe subscription of a client. A client can pay for several packages, each billed on its own schedule.
/// Client.stripeSubscriptionId is the client's main subscription (their bookkeeping package).
model ClientSubscription {
  id                           String    @id @default(cuid())
  clientId                     String
  client                       Client    @relation(fields: [clientId], references: [id])
  stripeSubscriptionId         String    @unique
  packageId                    String?
  package                      Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  /// What Stripe calls it (product names), shown when the subscription isn't linked to a portal package.
  productName                  String?
  /// Paid months of this package that already earned commission before the portal (the main package uses the
  /// client's own setting).
  commissionMonthsBeforePortal Int       @default(0)
  status                       String?
  endedAt                      DateTime?
  createdAt                    DateTime  @default(now())

  @@index([clientId])
}

model Client {
  /// The client's company (business) name; `name` is the contact person (Stripe's customer name).
  companyName           String?
  id                           String               @id @default(cuid())
  name                         String
  email                        String?
  phone                        String?
  billingState                 String?
  type                         ClientType           @default(DIRECT)
  status                       ClientStatus         @default(ONBOARDING)
  packageId                    String?
  package                      Package?             @relation(fields: [packageId], references: [id])
  /// Several clients (companies) can share one Stripe customer, each with its own subscriptions.
  stripeCustomerId             String?
  stripeSubscriptionId         String?              @unique
  ghlContactId                 String?
  defaultPaymentFunding        String?
  subscriptionStatus           String?
  commissionMonthsBeforePortal Int                  @default(0)
  acePrepaidUntil              DateTime?
  aceSlotId                    String?
  continuationDecision         String?
  clientAnswer                 String?
  continuationBy               String?
  clientAnsweredAt             DateTime?
  aceSetupSessionId            String?
  suspendedAt                  DateTime?
  suspensionWaivedAt           DateTime?
  /**
   * When the client started with Book Clarity (Stripe subscription start), for reports.
   */
  startedAt                    DateTime?
  onboarding                   Onboarding?
  createdAt                    DateTime             @default(now())
  endedAt                      DateTime?
  /// Pays by Zelle, check, PayPal, bill.com, wire… instead of through Stripe. Their Stripe subscription still sets
  /// the billing dates; the Super Admin is reminded before each due date and marks the payment by hand.
  paysOutsideStripe            Boolean              @default(false)
  outsidePaymentMethod         String?
  invoices                     Invoice[]
  subscriptions                ClientSubscription[]
  discounts                    Discount[]

  @@index([stripeCustomerId])
}

model Invoice {
  id                   String      @id @default(cuid())
  stripeInvoiceId      String      @unique
  clientId             String?
  client               Client?     @relation(fields: [clientId], references: [id])
  /// The Stripe subscription this invoice bills (a client can have several packages, each its own subscription).
  stripeSubscriptionId String?
  status               String
  subtotalCents        Int
  discountCents        Int         @default(0)
  cardFeeCents         Int         @default(0)
  onboardingCents      Int         @default(0)
  refundedCents        Int         @default(0)
  refundedPackageCents Int         @default(0)
  processingSince      DateTime?
  taxCents             Int         @default(0)
  seenRefundIds        String[]    @default([])
  totalCents           Int
  amountPaidCents      Int         @default(0)
  paidAt               DateTime?
  paymentMethodType    String?
  cardFunding          String?
  firstFailedAt        DateTime?
  periodStart          DateTime
  periodEnd            DateTime
  /**
   * When the bill was issued for its service period (Stripe's period_start looks back a cycle).
   */
  billedAt             DateTime    @default(now())
  /**
   * Emailed invoices: the date payment is due.
   */
  dueAt                DateTime?
  /**
   * Copied from Stripe history by the backfill: never earns commission or counts toward its window.
   */
  backfilled           Boolean     @default(false)
  kind                 InvoiceKind
  /// Paid outside Stripe (marked by hand; the Stripe invoice is marked "paid out of band").
  paidOutsideAt        DateTime?
  outsideMethod        String?
  outsideReference     String?
  outsideMarkedById    String?

  @@index([paidAt])
  @@index([billedAt])
  @@index([stripeSubscriptionId])
}

model Discount {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  kind           DiscountKind
  percentOff     Int?
  amountOffCents Int?
  months         Int
  reason         String
  stripeCouponId String
  createdById    String
  createdAt      DateTime     @default(now())
  replacedAt     DateTime?
}

model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([at, id])
  @@index([action, at])
}

model Setting {
  key   String @id
  value Json
}

model Executive {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Rows sharing (clientId, effectiveFrom) form one split version. Versions are never edited, only added.
model CommissionShare {
  id            String   @id @default(cuid())
  clientId      String
  executiveId   String
  rateBp        Int
  effectiveFrom DateTime
  createdById   String
  createdAt     DateTime @default(now())

  @@index([clientId, effectiveFrom])
}

enum CommissionKind {
  EARNED
  CLAWBACK
  ACE_PREPAID
}

/// Append-only commission ledger. The unique key makes every write idempotent.
model CommissionEntry {
  id          String         @id @default(cuid())
  executiveId String
  clientId    String
  invoiceId   String
  kind        CommissionKind
  refundKey   String         @default("")
  windowIndex Int?
  baseCents   Int
  rateBp      Int
  amountCents Int
  occurredAt  DateTime
  month       String
  createdAt   DateTime       @default(now())

  @@unique([executiveId, invoiceId, kind, refundKey])
  @@index([executiveId, month])
  @@index([clientId])
}

enum StatementStatus {
  OPEN
  PAID
}

model CommissionStatement {
  id          String          @id @default(cuid())
  executiveId String
  month       String
  status      StatementStatus @default(OPEN)
  paidAt      DateTime?
  paidById    String?
  totalCents  Int?

  @@unique([executiveId, month])
}

enum AcePayment {
  STRIPE
  OUT_OF_BAND
}

/// One bulk purchase by ACE: slots of 6 months of service + onboarding per package.
model AceBatch {
  id               String      @id @default(cuid())
  purchasedAt      DateTime
  note             String?
  totalCents       Int
  stripeInvoiceId  String?     @unique
  invoiceSentAt    DateTime?
  invoiceVersion   Int         @default(0)
  paidAt           DateTime?
  paidVia          AcePayment?
  paymentMethod    String?
  paymentReference String?
  /**
   * 3% fee ACE paid on top when paying a batch by credit card.
   */
  cardFeeCents     Int         @default(0)
  /**
   * Entered at migration: bought before the portal, commission already settled outside it.
   */
  historical       Boolean     @default(false)
  /**
   * Commission on the whole purchase (owner, 2026-11-27): when ACE pays, this executive earns rateBp of each slot's
   * price less the package's onboarding fee, whether or not the slot has a client yet. Null: the older rule
   * (each client's owner earns 6 × list price once the client is in a slot).
   */
  commissionExecutiveId String?
  commissionRateBp      Int?
  createdById      String
  createdAt        DateTime    @default(now())
}

model AceBatchLine {
  id             String @id @default(cuid())
  batchId        String
  packageId      String
  quantity       Int
  unitPriceCents Int

  @@index([batchId])
}

model AceSlot {
  id                 String    @id @default(cuid())
  batchId            String
  packageId          String
  clientId           String?   @unique
  startDate          DateTime?
  prepaidUntil       DateTime?
  customMonthlyCents Int?

  @@index([batchId, packageId])
}

/// One row per notice key: sends each notice at most once (retrying a failure once).
model Notification {
  id        String    @id @default(cuid())
  key       String    @unique
  kind      String
  clientId  String?
  to        String?
  channels  String    @default("")
  status    String
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([clientId])
}

/**
 * A client's self-serve onboarding progress (Plan 4B).
 */
model Onboarding {
  id                    String    @id @default(cuid())
  clientId              String    @unique
  client                Client    @relation(fields: [clientId], references: [id])
  packageId             String?
  monthlyCents          Int?
  onboardingFeeCents    Int?
  details               Json?
  signedAt              DateTime?
  signerName            String?
  signerIp              String?
  signedText            String?
  signedHash            String?
  contractVersion       String?
  quickbooks            String?
  /// Drawn signature (PNG data URL) when the client drew instead of typing their name.
  signatureImage        String?
  countersignedAt       DateTime?
  countersignedById     String?
  /// Drawn countersignature (PNG data URL), when the countersigner drew it.
  countersignatureImage String?
  feeInvoiceId          String?
  feeSetupSessionId     String?
  feePaidAt             DateTime?
  feeSubmittedAt        DateTime?
  feePaymentMethodId    String?
  stripeSubscriptionId  String?
  intake                Json?
  intakeAt              DateTime?
  callBookedAt          DateTime?
  /// The onboarding call as booked on Book Clarity's GHL calendar (synced; null until seen in GHL).
  callStartsAt          DateTime?
  callEventId           String?
  /// "booked" or "cancelled", as last seen in GHL.
  callStatus            String?
  completedAt           DateTime?
  lastProgressAt        DateTime  @default(now())
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
